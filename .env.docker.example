# =============================================================================
# Docker Environment Configuration - EXAMPLE
# =============================================================================
# This file contains example environment variables for the Docker Compose setup.
# Copy this file to .env.docker and update the values according to your needs.

# =============================================================================
# Application Configuration
# =============================================================================
NODE_ENV=production
PORT=3000

# =============================================================================
# MySQL Database Configuration
# =============================================================================
MYSQL_ROOT_PASSWORD=your_mysql_root_password_here
MYSQL_DATABASE=db_sahabat_ibu_hamil
MYSQL_USER=your_mysql_username
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_HOST=mysql-database
MYSQL_PORT=3306

# Additional MySQL variables for health check consistency
DB_ROOT_PASSWORD=your_mysql_root_password_here

# =============================================================================
# Prisma Database URL
# =============================================================================
# Format: mysql://username:password@host:port/database
DATABASE_URL=mysql://your_mysql_username:your_mysql_password_here@mysql-database:3306/db_sahabat_ibu_hamil

# =============================================================================
# phpMyAdmin Configuration
# =============================================================================
PMA_HOST=mysql-database
PMA_PORT=3306
PMA_USER=root
PMA_PASSWORD=your_mysql_root_password_here

# =============================================================================
# Redis Configuration
# =============================================================================
REDIS_HOST=redis-database
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=your_redis_password_here
REDIS_URL=redis://:your_redis_password_here@redis-database:6379

# =============================================================================
# Redis Insight Configuration
# =============================================================================
REDISINSIGHT_HOST=0.0.0.0
REDISINSIGHT_PORT=5540

# =============================================================================
# JWT Configuration
# =============================================================================
JWT_SECRET=your_jwt_secret_key_here_minimum_64_characters_long_for_security
JWT_EXPIRES_IN=7d

# =============================================================================
# Default User Seeding (for prisma/seed.ts)
# =============================================================================
DEFAULT_USER_NAME="Admin User"
DEFAULT_USER_EMAIL="admin@app.test"
DEFAULT_USER_PASSWORD="password"

# =============================================================================
# Public URL Configuration
# =============================================================================
PUBLIC_URL="http://localhost:3000/public"

# =============================================================================
# OpenAI Configuration
# =============================================================================
OPENAI_API_KEY="your_openai_api_key_here"
OPENAI_MODEL=gpt-4o-mini
OPENAI_PROJECT_NAME=your_openai_project_id_here
OPENAI_ENABLE=true

# =============================================================================
# Security Notes:
# =============================================================================
# 1. Change all default passwords before deploying to production
# 2. Use strong, unique passwords for each service
# 3. Never commit .env.docker with real credentials to version control
# 4. Consider using Docker secrets for sensitive data in production
# 5. Regularly rotate passwords and secrets
# 6. Generate a secure JWT secret using: openssl rand -hex 64
# 7. Use environment-specific values for different deployment stages