{
  "name": "sahabat-ibu-hamil-backend",
  "version": "1.0.0",
  "description": "API Server untuk proyek Sahabat Ibu Hamil",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.cjs",
    "start:prod": "NODE_ENV=production node dist/index.cjs",
    "lint": "eslint . --ext .ts",
    "test": "cross-env NODE_ENV=test dotenv -e .env.test -- jest --runInBand",
    "test:watch": "jest --watch",
    "db:seed": "tsx prisma/seed.ts"
  },
  "type": "module",
  "author": "Martin Mulyo Syahidin",
  "license": "ISC",
  "devDependencies": {
    "@babel/preset-env": "^7.28.3",
    "@babel/preset-typescript": "^7.27.1",
    "@eslint/js": "^9.36.0",
    "@jest/globals": "^30.1.2",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/dotenv": "^6.1.1",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.5.2",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.44.1",
    "@typescript-eslint/parser": "^8.44.1",
    "babel-jest": "^30.1.2",
    "cross-env": "^10.0.0",
    "dotenv-cli": "^10.0.0",
    "eslint": "^9.36.0",
    "jest": "^30.1.3",
    "prisma": "^6.16.2",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.4",
    "tsc-alias": "^1.8.16",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "ttypescript": "^1.5.15",
    "typescript": "^5.9.2",
    "typescript-transform-paths": "^3.5.5"
  },
  "jest": {
    "transform": {
      "^.+\\.[t|j]sx?$": "babel-jest"
    },
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    }
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@prisma/client": "^6.16.2",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/socket.io": "^3.0.1",
    "@whiskeysockets/baileys": "^7.0.0-rc.4",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.34.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.15.1",
    "openai": "^5.23.0",
    "pino": "^9.11.0",
    "qrcode-terminal": "^0.12.0",
    "socket.io": "^4.8.1",
    "zod": "^3.23.8"
  }
}
