generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ===== ENUMS =====

enum DeviceStatus {
  DRAFT
  PENDING_CONNECT
  FAILED_CONNECT
  CONNECTED
  DISCONNECTED
  RECONNECTING
}

enum MessageContentSource {
  SYSTEM
  USER
  MODEL
}

enum MessageDirection {
  IN
  OUT
}

enum MessageType {
  TEXT
  EXTENDED_TEXT
  IMAGE
  VIDEO
  AUDIO
  VOICE
  DOCUMENT
  STICKER
  LOCATION
  LIVE_LOCATION
  CONTACT
  CONTACTS
  BUTTON_REPLY
  LIST_REPLY
  INTERACTIVE
  REACTION
  POLL
  PRODUCT
  GROUP_INVITE
  VIEW_ONCE
  EPHEMERAL
  OTHER
}

enum ReminderTimeOfDay {
  MORNING
  AFTERNOON
  EVENING
  CUSTOM
}

enum ReminderLogStatus {
  SCHEDULED
  DISPATCHED
  STARTED
  SENT
  SKIPPED
  FAILED
}

enum BullJobState {
  WAITING
  DELAYED
  ACTIVE
  COMPLETED
  FAILED
  PAUSED
  STALLED
  RETRY
  REMOVED
}

enum BullJobEventType {
  ADDED
  WAITING
  DELAYED
  ACTIVE
  PROGRESS
  COMPLETED
  FAILED
  STALLED
  RETRY
  REMOVED
}

enum ConsultationStatus {
  WAITING
  VIEWED
  ANSWERED
}

enum AiRequestStatus {
  PENDING
  SUCCESS
  ERROR
  TIMEOUT
  CANCELLED
}

enum AiEndpoint {
  CHAT_COMPLETIONS_CREATE
  COMPLETIONS_CREATE
  EMBEDDINGS_CREATE
  IMAGES_GENERATE
  AUDIO_TRANSCRIPTIONS_CREATE
  AUDIO_TRANSLATIONS_CREATE
  MODERATIONS_CREATE
}

enum AiModel {
  GPT_4O_MINI
  GPT_4O
  GPT_4_TURBO
  GPT_3_5_TURBO
  CLAUDE_3_5_SONNET
  CLAUDE_3_HAIKU
  GEMINI_PRO
  GEMINI_FLASH
}
 
// ===== MODELS =====
 
model User {
  id                 Int       @id @default(autoincrement())
  name               String    @db.VarChar(255)
  email              String    @unique @db.VarChar(255)
  email_verified_at  DateTime?
  password           String    @db.VarChar(255)
  remember_token     String?   @db.VarChar(100)
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt
 
  @@map("users")
}

model Device {
  id             Int            @id @default(autoincrement())
  name           String         @db.VarChar(255)
  code           String         @unique @db.VarChar(20)
  status         DeviceStatus   @default(DRAFT)
  phone_number   String?        @db.VarChar(20)
  device_id      String?        @db.VarChar(255)
  created_at     DateTime       @default(now())
  updated_at     DateTime       @updatedAt
  deleted_at     DateTime?

  // Relations
  chats           Chat[]
  ai_request_logs AiRequestLog[]
 
  @@index([status])
  @@index([code])
  @@map("devices")
}

model Chat {
  id             Int       @id @default(autoincrement())
 
  // FK to devices
  device_id      Int
  device         Device    @relation(fields: [device_id], references: [id], onDelete: Cascade)
 
  wa_number      String    @db.VarChar(20)
  name           String?   @db.VarChar(255)
  age            Int?
  consent_at     DateTime?
 
  // Conversation state
  scene_stack    Json      @default("[\"menu.root\"]")
  ctx            Json      @default("{}")
 
  last_active_at DateTime? @db.Timestamp(3)
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt
  deleted_at     DateTime?

  openai_conversation_id String? @db.VarChar(255)

  // Relations
  messages       Message[]
  reminders      Reminder[]
  ai_request_logs AiRequestLog[]
  consultations   Consultation[]
 
  @@index([wa_number])
  @@index([device_id])
  @@index([last_active_at])
  @@map("chats")
}

model Message {
  id           Int                   @id @default(autoincrement())
  chat_id      Int
  chat         Chat                  @relation(fields: [chat_id], references: [id], onDelete: Cascade)
 
  source       MessageContentSource
  direction    MessageDirection
  type         MessageType           @default(TEXT)
  body         String?               @db.Text
  media        Json?
  meta         Json?
  created_at   DateTime              @default(now())
 
  @@index([chat_id, created_at])
  @@index([source])
  @@index([direction])
  @@map("messages")
}

model Reminder {
  id                Int       @id @default(autoincrement())
  chat_id           Int
  chat              Chat      @relation(fields: [chat_id], references: [id], onDelete: Cascade)
 
  active            Boolean   @default(true)
  time_of_day       ReminderTimeOfDay
  custom_time       String?           @db.VarChar(8)
  tz                String    @default("Asia/Jakarta") @db.VarChar(50)
  last_run_at       DateTime?
  next_run_message  String?   @db.Text
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  reminder_logs    ReminderLog[]
  reminder_jobs    ReminderJob[]
 
  @@unique([chat_id, time_of_day])
  @@index([chat_id])
  @@map("reminders")
}

// Simplified Job model for reminder scheduling
model ReminderJob {
  id             String            @id @db.VarChar(191) // Bull MQ job ID
  reminder_id    Int
  reminder       Reminder          @relation(fields: [reminder_id], references: [id], onDelete: Cascade)
  
  // Job status and timing
  status         BullJobState      @default(WAITING)
  scheduled_for  DateTime          // When this job should run
  started_at     DateTime?
  completed_at   DateTime?
  failed_at      DateTime?
  
  // Job data and error handling
  message        String?           @db.Text // Message to be sent
  attempts       Int               @default(0)
  max_attempts   Int               @default(3)
  error_message  String?           @db.Text
  
  created_at     DateTime          @default(now())
  updated_at     DateTime          @updatedAt
  
  @@index([reminder_id])
  @@index([status, scheduled_for])
  @@index([scheduled_for])
  @@map("reminder_jobs")
}

// Simplified log for tracking reminder execution history
model ReminderLog {
  id               Int               @id @default(autoincrement())
  reminder_id      Int
  reminder         Reminder          @relation(fields: [reminder_id], references: [id], onDelete: Cascade)
  
  // Execution details
  status           ReminderLogStatus @default(SCHEDULED)
  scheduled_for    DateTime          // When it was supposed to run
  executed_at      DateTime?         // When it actually ran
  message_sent     String?           @db.Text // Message that was sent
  error_message    String?           @db.Text
  
  // Job reference (optional, for tracking)
  job_id           String?           @db.VarChar(191)
  
  created_at       DateTime          @default(now())
  
  @@index([reminder_id])
  @@index([status, scheduled_for])
  @@map("reminder_logs")
}

model Consultation {
  id             Int       @id @default(autoincrement())
  chat_id        Int
  chat           Chat      @relation(fields: [chat_id], references: [id], onDelete: Cascade)

  message         String?           @db.Text
  answer          String?           @db.Text
  status          ConsultationStatus @default(WAITING)
  viewed_at       DateTime?
  answered_at     DateTime?
 
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  @@index([chat_id])
  @@index([status])
  @@map("consultations")
}

// ===== AI LOGGING TABLES =====

model AiRequestLog {
  id                  BigInt            @id @default(autoincrement())
  
  // Request identification
  chat_id             Int?
  device_id           Int?
  
  // Request details
  provider            String            @default("openai") @db.VarChar(50)
  endpoint            AiEndpoint
  model               AiModel
  
  // Payload and response
  request_payload     Json
  response_payload    Json?
  response_text       String?           @db.Text
  
  // Metrics
  input_tokens        Int               @default(0)
  output_tokens       Int               @default(0)
  total_tokens        Int               @default(0)
  
  // Cost tracking (in USD)
  input_cost_usd      Decimal           @default(0) @db.Decimal(10, 6)
  output_cost_usd     Decimal           @default(0) @db.Decimal(10, 6)
  total_cost_usd      Decimal           @default(0) @db.Decimal(10, 6)
  
  // Performance metrics
  latency_ms          Int               @default(0)
  retries             Int               @default(0)
  
  // Status and error handling
  status              AiRequestStatus   @default(PENDING)
  error_message       String?           @db.Text
  error_code          String?           @db.VarChar(100)
  
  // Metadata
  project             String?           @db.VarChar(100)
  tags                Json?             // Array of strings
  meta                Json?             // Additional metadata
  
  // Features used
  response_format     String?           @db.VarChar(50)  // json, text, etc
  stream              Boolean           @default(false)
  tool_calling_used   Boolean           @default(false)
  prompt_caching_used Boolean           @default(false)
  
  // Timestamps
  requested_at        DateTime          @default(now())
  responded_at        DateTime?
  created_at          DateTime          @default(now())
  updated_at          DateTime          @updatedAt
  
  // Relations
  device              Device?           @relation(fields: [device_id], references: [id], onDelete: SetNull)
  chat                Chat?             @relation(fields: [chat_id], references: [id], onDelete: SetNull)
  response_chunks     AiResponseChunk[]
  
  @@index([chat_id])
  @@index([device_id])
  @@index([provider, model])
  @@index([status])
  @@index([requested_at])
  @@index([project])
  @@map("ai_request_logs")
}

model AiResponseChunk {
  id              BigInt       @id @default(autoincrement())
  request_log_id  BigInt
  request_log     AiRequestLog @relation(fields: [request_log_id], references: [id], onDelete: Cascade)
  
  chunk_index     Int
  content         String       @db.Text
  finish_reason   String?      @db.VarChar(50)
  
  // Token info per chunk
  tokens          Int          @default(0)
  
  created_at      DateTime     @default(now())
  
  @@index([request_log_id, chunk_index])
  @@map("ai_response_chunks")
}
